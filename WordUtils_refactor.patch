+    /**
+     * Finds the next wrap position in the string using the given pattern.
+     *
+     * @param str the string to search in
+     * @param offset the current offset in the original string
+     * @param wrapLength the maximum length to search within
+     * @param patternToWrapOn the pattern to match for wrap positions
+     * @param inputLineLength the total length of the input string
+     * @param searchBeyond true if searching beyond wrapLength, false for normal search
+     * @return an int array where [0] = spaceToWrapAt (-1 if not found), [1] = matcherSize (-1 if not found or not applicable), [2] = 1 if matcher.start()==0 case was triggered
+     */
+    private static int[] findNextWrapPosition(final String str,
+                                               final int offset,
+                                               final int wrapLength,
+                                               final Pattern patternToWrapOn,
+                                               final int inputLineLength,
+                                               final boolean searchBeyond) {
+        final int searchStart;
+        final int searchEnd;
+        if (searchBeyond) {
+            searchStart = offset + wrapLength;
+            searchEnd = inputLineLength;
+        } else {
+            searchStart = offset;
+            searchEnd = (int) Math.min(Integer.MAX_VALUE, offset + wrapLength + 1L);
+        }
+        
+        final Matcher matcher = patternToWrapOn.matcher(str.substring(searchStart, Math.min(searchEnd, inputLineLength)));
+        if (matcher.find()) {
+            if (searchBeyond) {
+                final int matcherSize = matcher.end() - matcher.start();
+                final int spaceToWrapAt = matcher.start() + searchStart;
+                return new int[] {spaceToWrapAt, matcherSize, 0};
+            } else {
+                if (matcher.start() == 0) {
+                    final int matcherSize = matcher.end();
+                    return new int[] {-1, matcherSize, 1};
+                }
+                final int spaceToWrapAt = matcher.start() + offset;
+                return new int[] {spaceToWrapAt, -1, 0};
+            }
+        }
+        return new int[] {-1, -1, 0};
+    }
